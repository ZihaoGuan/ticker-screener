//@version=6
indicator("Ticker Screener Relative Strength", shorttitle="TS RS", overlay=false)

// The host replaces this default with its configured benchmark before compilation.
// PineTS 0.2.15 records string input overrides but does not apply them while
// evaluating input.string(), so the chart also indexes this bare symbol in Vela.
benchmark = input.string("__TICKER_SCREENER_BENCHMARK__", "Benchmark")
benchmarkClose = request.security(benchmark, "D", close)
rsLine = benchmarkClose > 0 ? close / benchmarkClose : na

plot(rsLine, "RS line", color=color.rgb(56, 189, 248), linewidth=2)
plot(ta.ema(rsLine, 21), "RS 21 EMA", color=color.rgb(245, 158, 11), linewidth=2)
